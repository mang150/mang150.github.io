      showElement("error-value-currency1");
   }
   if (city2.length === 0) {
      showElement("error-value-currency2");
   }
   // Ensure both currency names provided
   if (currency1.length > 0 && currency2.length > 0) {
      showElement("convert");
      hideElement("error-loading-currency1");
      hideElement("error-loading-currency2");
      showElement("loading-currency1");
      showText("loading-currency1", `Loading ${currency1}...`);
      showElement("loading-currency2");
