$(function() {
   $("#compareBtn").click(compareBtnClick);
   $("#currency1").on("input", currencyInput);
   $("#currency2").on("input", currencyInput);
  // Called when currency input values change
function currencyInput(e) {
   // Extract the text from city input that triggered the callback
   const currencyId = e.target.id;
   const currency = $(`#${currencyId}`).val().trim();
 // Only show error message if no city 
   if (currency === 0) {
      showElement("error-value-" + currencyId);      
   }
   else {
      hideElement("error-value-" + currencyId);
   }
}  
  // Compare button is clicked
function compareBtnClick() {
